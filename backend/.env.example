# =====================================================================
# StockSense Backend Environment Configuration
# =====================================================================

# Secret key for signing JWT tokens (replace with a random string in production)
SECRET_KEY=stocksense-hackathon-insecure-secret-key-change-in-prod

# Database URL (defaults to SQLite stocksense.db inside backend/ if left blank)
# DATABASE_URL=sqlite:///./stocksense.db

# ---------------------------------------------------------------------
# Real Email (SMTP) Configuration
# ---------------------------------------------------------------------
# To enable real OTP email delivery to user inboxes:
#
# Option A: Gmail SMTP (Recommended for Hackathons)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate a 16-character "App Password": https://myaccount.google.com/apppasswords
# 3. Fill in the values below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_app_password

# Option B: Outlook / Hotmail
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=your_email@outlook.com
# SMTP_PASSWORD=your_password
